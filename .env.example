# Supabase Configuration
# Copy this file to .env.local and fill in your values.
# Get these from: https://supabase.com → Your Project → Settings → API

# Supabase project URL (safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose in frontend when RLS is configured)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# NEVER ADD THE FOLLOWING TO THIS FILE OR ANY FRONTEND CODE:
# SUPABASE_SERVICE_ROLE_KEY — keep this server-side only!
# ============================================================
